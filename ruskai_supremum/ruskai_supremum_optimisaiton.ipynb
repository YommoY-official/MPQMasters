    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"arr = []\\n\",\n",
    "    \"k = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"px_list = []\\n\",\n",
    "    \"py_list = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for px in np.linspace(px_min, px_max, size):\\n\",\n",
    "    \"    for py in np.linspace(py_min, 1-px, size):\\n\",\n",
    "    \"        px_list.append(px)\\n\",\n",
    "    \"        py_list.append(py)\\n\",\n",
    "    \"        opt = optimal_value(px,py)\\n\",\n",
    "    \"        best_val = best_val_list[k]\\n\",\n",
