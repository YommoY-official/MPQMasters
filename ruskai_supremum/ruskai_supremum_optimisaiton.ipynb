    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-19T13:31:41.689627Z\",\n",
    "     \"start_time\": \"2026-02-19T13:27:24.080501Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"best_raw_list = []\\n\",\n",
    "    \"best_val_list = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for px in np.linspace(px_min, px_max, size):\\n\",\n",
    "    \"    for py in np.linspace(px_min, 1-px, size):\\n\",\n",
    "    \"        opt = optimal_value(px,py)\\n\",\n",
    "    \"        best_raw, best_val = maximize(px,py,steps,lr, restarts,seed )\\n\",\n",
    "    \"        best_raw_list.append(best_raw)\\n\",\n",
    "    \"        best_val_list.append(best_val)\\n\",\n",
    "    \"        #print(\\\"\\\\npx value:\\\", px)\\n\",\n",
    "    \"        #print(\\\"\\\\npy value:\\\", py)\\n\",\n",
    "    \"        #print(\\\"\\\\nOptimal value:\\\", opt)\\n\",\n",
    "    \"        #print(\\\"\\\\nBest value found:\\\", best_val)\\n\",\n",
    "    \"        #print(\\\"Best raw parameters:\\\", best_raw.cpu().numpy())\\n\",\n",
    "    \"        #print(\\\"\\\\nDifference in values:\\\", best_val - opt)\"\n",
    "   ],\n",
