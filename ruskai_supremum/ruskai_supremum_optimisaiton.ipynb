    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"import math\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import torch.nn.functional as F\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from matplotlib import cm\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-15T18:01:29.045864Z\",\n",
    "     \"start_time\": \"2026-03-15T18:01:29.040854Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"print(\\\"hello\\\")\",\n",
    "   \"id\": \"17bc3dff6f53e894\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"hello\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-19T13:27:23.811028Z\",\n",
    "     \"start_time\": \"2026-02-19T13:27:23.804726Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"torch.set_default_dtype(torch.float64)\\n\",\n",
    "    \"device = \\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\"\"\n",
    "   ],\n",
    "   \"id\": \"614b9f4f756cf670\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-19T13:27:23.884122Z\",\n",
    "     \"start_time\": \"2026-02-19T13:27:23.831978Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"I2 = torch.eye(2, dtype=torch.complex128, device=device)\\n\",\n",
    "    \"X  = torch.tensor([[0, 1], [1, 0]], dtype=torch.complex128, device=device)\\n\",\n",
    "    \"Y  = torch.tensor([[0, -1j], [1j, 0]], dtype=torch.complex128, device=device)\\n\",\n",
    "    \"Z  = torch.tensor([[1, 0], [0, -1]], dtype=torch.complex128, device=device)\\n\"\n",
    "   ],\n",
    "   \"id\": \"d4b405d989d53de1\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-19T13:27:23.967749Z\",\n",
    "     \"start_time\": \"2026-02-19T13:27:23.901226Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def channel(rho, px, py):\\n\",\n",
    "    \"    # px, py are python floats or torch scalars\\n\",\n",
    "    \"    px_t = torch.as_tensor(px, dtype=torch.float64, device=device)\\n\",\n",
    "    \"    py_t = torch.as_tensor(py, dtype=torch.float64, device=device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ensure valid probs (for safety)\\n\",\n",
    "    \"    p0 = torch.clamp(1.0 - px_t - py_t, min=0.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    kraus = [\\n\",\n",
    "    \"        torch.sqrt(p0).to(torch.complex128) * I2,\\n\",\n",
    "    \"        torch.sqrt(px_t).to(torch.complex128) * X,\\n\",\n",
    "    \"        torch.sqrt(py_t).to(torch.complex128) * Y,\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    out = torch.zeros_like(rho)\\n\",\n",
    "    \"    for K1 in kraus:\\n\",\n",
    "    \"        for K2 in kraus:\\n\",\n",
    "    \"            op = torch.kron(K1, K2)  # 4x4\\n\",\n",
    "    \"            out = out + op @ rho @ op.conj().T\\n\",\n",
    "    \"    return out\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def trace_norm_hermitian(H):\\n\",\n",
    "    \"    # For Hermitian H: ||H||_1 = sum |eigs|\\n\",\n",
    "    \"    evals = torch.linalg.eigvalsh(H)\\n\",\n",
    "    \"    return torch.sum(torch.abs(evals))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def density_matrix(psi):\\n\",\n",
    "    \"    return psi[:, None] @ psi.conj()[None, :]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def softplus_unit_sphere(u, eps=1e-12):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    u: real tensor of shape (4,)\\n\",\n",
    "    \"    returns: tensor (4,) with sum of squares = 1 and all entries > 0\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    v = F.softplus(u)                  # v_i > 0\\n\",\n",
    "    \"    norm = torch.sqrt(torch.sum(v*v).clamp(min=eps))\\n\",\n",
    "    \"    return v / norm\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ----------------------------\\n\",\n",
    "    \"# Your objective, but made safe & differentiable\\n\",\n",
    "    \"# We optimize over an unconstrained raw vector in R^11\\n\",\n",
    "    \"# and map it to your param format:\\n\",\n",
    "    \"# [a1,a2,theta2,a3,theta3,b1,phi1,b2,phi2,b3,phi3]\\n\",\n",
    "    \"# ----------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def objective_from_raw(raw, px=0.3, py=0.2, eps=1e-12):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    raw: torch.float64 tensor shape (13,) unconstrained\\n\",\n",
    "    \"    returns: scalar real tensor to maximize\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # amplitudes in (0,1)\\n\",\n",
    "    \"    # indices: a0=11,a1=0,a2=1,a3=3,b0=12,b1=5,b2=7,b3=9\\n\",\n",
    "    \"    sig = torch.sigmoid\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # angles in [0, 2π)\\n\",\n",
    "    \"    twopi = 2.0 * math.pi\\n\",\n",
    "    \"    theta2 = twopi * sig(raw[2])\\n\",\n",
    "    \"    theta3 = twopi * sig(raw[4])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    phi1   = twopi * sig(raw[6])\\n\",\n",
    "    \"    phi2   = twopi * sig(raw[8])\\n\",\n",
    "    \"    phi3   = twopi * sig(raw[10])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # a0, b0 with clamping to avoid sqrt of negative\\n\",\n",
    "    \"    # ---- amplitudes for psi ----\\n\",\n",
    "    \"    u_psi = raw[[11,0,1,3]]  # pick 4 real params\\n\",\n",
    "    \"    a0, a1, a2, a3 = softplus_unit_sphere(u_psi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ---- amplitudes for phi ----\\n\",\n",
    "    \"    u_phi = raw[[12,5,7,9]]  # pick 4 real params\\n\",\n",
    "    \"    b0, b1, b2, b3 = softplus_unit_sphere(u_phi)\\n\",\n",
    "    \"    # compute theta1 from your constraint (with eps to avoid division by 0)\\n\",\n",
    "    \"    denom = a1 * b1\\n\",\n",
    "    \"    denom = torch.clamp(denom, min=eps)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # complex expression inside log\\n\",\n",
    "    \"    # NOTE: keep everything as complex here\\n\",\n",
    "    \"    num = (\\n\",\n",
    "    \"        a0 * b0\\n\",\n",
    "    \"        + a2 * b2 * torch.exp(1j * (theta2 - phi2))\\n\",\n",
    "    \"        + a3 * b3 * torch.exp(1j * (theta3 - phi3))\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    z = -(num / denom)  # complex\\n\",\n",
    "    \"\\n\",\n",
    "    \"    theta1 = phi1 + torch.atan2( torch.imag(z)  , torch.real(z) ) # complex\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # build psi, phi in C^4\\n\",\n",
    "    \"    psi = torch.zeros(4, dtype=torch.complex128, device=device)\\n\",\n",
    "    \"    psi[0] = a0.to(torch.complex128)\\n\",\n",
    "    \"    psi[1] = a1.to(torch.complex128) * torch.exp(1j * theta1)\\n\",\n",
    "    \"    psi[2] = a2.to(torch.complex128) * torch.exp(1j * theta2)\\n\",\n",
    "    \"    psi[3] = a3.to(torch.complex128) * torch.exp(1j * theta3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    phi = torch.zeros(4, dtype=torch.complex128, device=device)\\n\",\n",
    "    \"    phi[0] = b0.to(torch.complex128)\\n\",\n",
    "    \"    phi[1] = b1.to(torch.complex128) * torch.exp(1j * phi1)\\n\",\n",
    "    \"    phi[2] = b2.to(torch.complex128) * torch.exp(1j * phi2)\\n\",\n",
    "    \"    phi[3] = b3.to(torch.complex128) * torch.exp(1j * phi3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    delta = density_matrix(psi) - density_matrix(phi)  # 4x4 Hermitian\\n\",\n",
    "    \"    H = channel(delta, px=px, py=py)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return 0.5 * trace_norm_hermitian(H)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ----------------------------\\n\",\n",
    "    \"# Optimizer runner (maximization via minimizing -objective)\\n\",\n",
    "    \"# ----------------------------\\n\",\n",
    "    \"def maximize(px=0.3, py=0.2, steps=4000, lr=2e-2, restarts=10, seed=0, print_every=400):\\n\",\n",
    "    \"    torch.manual_seed(seed)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    best_val = -float(\\\"inf\\\")\\n\",\n",
    "    \"    best_raw = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for r in range(restarts):\\n\",\n",
    "    \"        raw = (0.1 * torch.randn(13, device=device)).requires_grad_(True)\\n\",\n",
    "    \"        opt = torch.optim.Adam([raw], lr=lr)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for t in range(steps):\\n\",\n",
    "    \"            opt.zero_grad()\\n\",\n",
    "    \"            f = objective_from_raw(raw, px=px, py=py)\\n\",\n",
    "    \"            loss = -f\\n\",\n",
    "    \"            loss.backward()\\n\",\n",
    "    \"            opt.step()\\n\",\n",
    "    \"\\n\",\n",
    "    \"            #if (t + 1) % print_every == 0:\\n\",\n",
    "    \"            #    print(f\\\"[restart {r+1}/{restarts}] step {t+1:5d} | f = {f.item():.12f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        final_f = objective_from_raw(raw, px=px, py=py).detach().item()\\n\",\n",
    "    \"        if final_f > best_val:\\n\",\n",
    "    \"            best_val = final_f\\n\",\n",
    "    \"            best_raw = raw.detach().clone()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return best_raw, best_val\\n\",\n",
    "    \"\\n\",\n",
    "    \"def optimal_value(px,py):\\n\",\n",
    "    \"    return max(abs(1-2*px),abs(1-2*py), abs(1-2*px-2*py))\"\n",
    "   ],\n",
    "   \"id\": \"d4f7edf4e4495082\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-19T13:27:24.065618Z\",\n",
    "     \"start_time\": \"2026-02-19T13:27:23.983299Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"lr = 2e-3\\n\",\n",
    "    \"seed = 10\\n\",\n",
    "    \"epsilon = 1e-12\\n\",\n",
    "    \"\\n\",\n",
    "    \"px_min = epsilon\\n\",\n",
    "    \"py_min = epsilon\\n\",\n",
    "    \"px_max = 1-epsilon\\n\",\n",
    "    \"\\n\",\n",
    "    \"size = 5\\n\",\n",
    "    \"steps = 1000\\n\",\n",
    "    \"restarts = 3\\n\",\n",
    "    \"\\n\"\n",
    "   ],\n",
    "   \"id\": \"6db742cd9e5554de\",\n",
    "   \"outputs\": [],\n",
